{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "release": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "priceBase": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "defaultMetric": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "metrics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "shortLabel": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "gbp",
              "people",
              "ratio"
            ]
          },
          "rateScale": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 1000
              }
            ]
          },
          "levels": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "constituency",
                "local-authority"
              ]
            }
          },
          "denominators": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "total",
                "per-resident",
                "per-aged-0-15",
                "per-aged-16-64",
                "per-aged-66-plus"
              ]
            }
          },
          "defaultDenominator": {
            "type": "string",
            "enum": [
              "total",
              "per-resident",
              "per-aged-0-15",
              "per-aged-16-64",
              "per-aged-66-plus"
            ]
          },
          "periodKind": {
            "type": "string",
            "enum": [
              "fiscal-year",
              "month"
            ]
          },
          "periods": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "state-pension",
                "pension-credit",
                "attendance-allowance",
                "winter-fuel",
                "personal-independence",
                "disability-living",
                "carers",
                "universal-credit",
                "housing-benefit",
                "employment-support",
                "jobseekers",
                "income-support",
                "other"
              ]
            }
          },
          "provenance": {
            "type": "string",
            "enum": [
              "measured",
              "modelled",
              "apportioned",
              "survey"
            ]
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "period": {
                  "type": "string"
                },
                "nations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "england",
                      "wales",
                      "scotland"
                    ]
                  }
                }
              },
              "required": [
                "period",
                "nations"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "shortLabel",
          "description",
          "unit",
          "rateScale",
          "levels",
          "denominators",
          "defaultDenominator",
          "periodKind",
          "periods",
          "families",
          "provenance",
          "sources",
          "caveats",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "state-pension",
              "pension-credit",
              "attendance-allowance",
              "winter-fuel",
              "personal-independence",
              "disability-living",
              "carers",
              "universal-credit",
              "housing-benefit",
              "employment-support",
              "jobseekers",
              "income-support",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "administrator": {
                  "type": "string",
                  "enum": [
                    "DWP",
                    "SSS"
                  ]
                },
                "nations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "england",
                      "wales",
                      "scotland"
                    ]
                  }
                },
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "code",
                "label",
                "administrator",
                "nations",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "members"
        ],
        "additionalProperties": false
      }
    },
    "fiscalYears": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "outturn",
              "forecast"
            ]
          },
          "realGdp": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "realCpi": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "status",
          "realGdp",
          "realCpi"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "licence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "published",
          "licence"
        ],
        "additionalProperties": false
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "share-aged-0-15",
                  "share-aged-66-plus",
                  "deprivation-decile",
                  "median-pay",
                  "population-density"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "id",
              "label",
              "period",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "expected": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "period": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "share-aged-0-15",
                  "share-aged-66-plus",
                  "deprivation-decile",
                  "median-pay",
                  "population-density"
                ]
              }
            },
            "fits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "actualMetric": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "denominator": {
                    "type": "string",
                    "enum": [
                      "total",
                      "per-resident",
                      "per-aged-0-15",
                      "per-aged-16-64",
                      "per-aged-66-plus"
                    ]
                  },
                  "levels": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "enum": [
                        "constituency",
                        "local-authority"
                      ]
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "observations": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rSquared": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "terms": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1
                              },
                              "coefficient": {
                                "type": "number"
                              },
                              "standardError": {
                                "type": "number",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "id",
                              "label",
                              "coefficient",
                              "standardError"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "observations",
                        "rSquared",
                        "terms"
                      ],
                      "additionalProperties": false
                    },
                    "required": [
                      "constituency",
                      "local-authority"
                    ]
                  }
                },
                "required": [
                  "metric",
                  "actualMetric",
                  "denominator",
                  "levels"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "method",
            "period",
            "inputs",
            "fits"
          ],
          "additionalProperties": false
        },
        "neighbours": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "features": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "share-aged-0-15",
                  "share-aged-66-plus",
                  "deprivation-decile",
                  "median-pay",
                  "population-density"
                ]
              }
            }
          },
          "required": [
            "method",
            "count",
            "features"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "inputs",
        "expected",
        "neighbours"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"
        },
        "nations": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "england",
              "wales",
              "scotland"
            ]
          }
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "groups": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "claimants": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "label",
              "claimants",
              "share"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "month",
        "nations",
        "sources",
        "groups"
      ],
      "additionalProperties": false
    },
    "decomposition": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {
                "type": "string",
                "enum": [
                  "state-pension",
                  "pension-credit",
                  "attendance-allowance",
                  "winter-fuel",
                  "personal-independence",
                  "disability-living",
                  "carers",
                  "universal-credit",
                  "housing-benefit",
                  "employment-support",
                  "jobseekers",
                  "income-support",
                  "other"
                ]
              },
              "benefit": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "claimantUnit": {
                "type": "string",
                "enum": [
                  "people",
                  "households"
                ]
              },
              "denominator": {
                "type": "string",
                "enum": [
                  "total",
                  "per-resident",
                  "per-aged-0-15",
                  "per-aged-16-64",
                  "per-aged-66-plus"
                ]
              },
              "from": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"
              },
              "to": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"
              },
              "populationPeriods": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^mid-\\d{4}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^mid-\\d{4}$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "nations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "england",
                    "wales",
                    "scotland"
                  ]
                }
              },
              "gb": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "constituency",
                    "local-authority"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "population": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "claimants": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "meanWeeklyAward": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "population",
                    "claimants",
                    "meanWeeklyAward"
                  ],
                  "additionalProperties": false
                },
                "required": [
                  "constituency",
                  "local-authority"
                ]
              }
            },
            "required": [
              "family",
              "benefit",
              "claimantUnit",
              "denominator",
              "from",
              "to",
              "populationPeriods",
              "nations",
              "gb"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "method",
        "families"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "release",
    "priceBase",
    "defaultMetric",
    "metrics",
    "families",
    "fiscalYears",
    "sources",
    "caveats",
    "models",
    "conditions",
    "decomposition"
  ],
  "additionalProperties": false
}
