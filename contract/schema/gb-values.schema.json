{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "release": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "level": {
      "type": "string",
      "enum": [
        "constituency",
        "local-authority"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "denominator": {
            "type": "string",
            "enum": [
              "total",
              "per-resident",
              "per-aged-0-15",
              "per-aged-16-64",
              "per-aged-66-plus"
            ]
          },
          "periodKind": {
            "type": "string",
            "enum": [
              "fiscal-year",
              "month"
            ]
          },
          "periods": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "rankOf": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "metric",
          "denominator",
          "periodKind",
          "periods",
          "values",
          "rankOf"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "release",
    "level",
    "series"
  ],
  "additionalProperties": false
}
