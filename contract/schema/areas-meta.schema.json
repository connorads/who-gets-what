{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "release": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "level": {
      "type": "string",
      "enum": [
        "constituency",
        "local-authority"
      ]
    },
    "boundarySet": {
      "type": "string",
      "enum": [
        "PCON24",
        "LAD23"
      ]
    },
    "areaOrderHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "populationPeriod": {
      "type": "string",
      "pattern": "^mid-\\d{4}$"
    },
    "hexLayout": {
      "type": "string",
      "const": "odd-r"
    },
    "bounds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[ESW]\\d{8}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "nation": {
            "type": "string",
            "enum": [
              "england",
              "wales",
              "scotland"
            ]
          },
          "bounds": {
            "type": "array",
            "prefixItems": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "code",
          "name",
          "nation",
          "bounds"
        ],
        "additionalProperties": false
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[ESW]\\d{8}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nation": {
            "type": "string",
            "enum": [
              "england",
              "wales",
              "scotland"
            ]
          },
          "region": {
            "type": "string",
            "pattern": "^[ESW]\\d{8}$"
          },
          "hex": {
            "type": "object",
            "properties": {
              "q": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "r": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "q",
              "r"
            ],
            "additionalProperties": false
          },
          "centroid": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "population": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "name",
          "slug",
          "nation",
          "region",
          "hex",
          "centroid",
          "population"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "release",
    "level",
    "boundarySet",
    "areaOrderHash",
    "populationPeriod",
    "hexLayout",
    "bounds",
    "regions",
    "areas"
  ],
  "additionalProperties": false
}
