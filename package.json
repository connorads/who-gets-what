{
  "name": "who-gets-what",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/og.ts && node scripts/robots.ts",
    "size": "node scripts/size.ts",
    "prerender:check": "node scripts/prerender-check.ts",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "./node_modules/.bin/tsc -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src scripts e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "perf:explore": "PERF=1 playwright test --grep @perf",
    "data:ingest": "uv run --project pipeline wgw-pipeline ingest",
    "data:compile": "uv run --project pipeline wgw-pipeline compile",
    "data:test": "uv run --project pipeline pytest",
    "data:release": "uv run --project pipeline wgw-pipeline release",
    "data:pull": "node scripts/data-pull.ts",
    "audio:build": "node scripts/audio/build.ts",
    "prepare": "[ -n \"$CI\" ] && exit 0 || git config --local core.hooksPath .hk-hooks"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/engine": "^9.4.2",
    "@luma.gl/shadertools": "^9.4.2",
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "earcut": "^3.2.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@takumi-rs/core": "^2.14.0",
    "@takumi-rs/helpers": "^2.14.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@11.27.0"
}
